{
  "name": "ocean",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty",
    "clean": "tsc -b --clean",
    "test": "vitest run --config vitest.source.config.ts",
    "test:watch": "vitest --config vitest.source.config.ts",
    "test:process": "pnpm build && vitest run --config vitest.process.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm typecheck:tests && pnpm lint && pnpm test && pnpm test:process",
    "runne": "node apps/cli/dist/main.js",
    "ocean": "node apps/cli/dist/main.js",
    "package:release": "pnpm build && node apps/cli/dist/release/package.js",
    "typecheck:tests:node": "tsc -p tsconfig.tests.node.json --pretty false",
    "typecheck:tests:desktop": "tsc -p tsconfig.tests.desktop.json --pretty false",
    "typecheck:tests": "pnpm typecheck:tests:node && pnpm typecheck:tests:desktop"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@runnets/tools-node": "workspace:*",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "rolldown": "1.2.16",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  }
}
